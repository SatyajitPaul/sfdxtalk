---
// Article page (docs/PLAN.md §5): category tree · content · "On this page".
// Everything visible here comes from the same frontmatter as the JSON-LD.
//
// Search indexing: <article data-pagefind-body> holds the H1, quick answer,
// body and FAQ. Navigation inside it is marked data-pagefind-ignore; the meta
// line is ignored as text but still supplies the search filters.
import { render } from 'astro:content';
import '../../styles/article.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Comments from '../../components/article/Comments.astro';
import DocsNav from '../../components/article/DocsNav.astro';
import Toc from '../../components/article/Toc.astro';
import { FAQ_SECTION, buildToc, neighbours } from '../../lib/article';
import { contributorsFor } from '../../lib/contributors';
import { docUrl, getDocs, type Doc } from '../../lib/docs';
import { byCategory, docMarkdownUrl, isoDate } from '../../lib/export';
import { releaseUrl, tagUrl } from '../../lib/hubs';
import { docOgImageAlt, docOgImagePath } from '../../lib/og-image';
import { articleGraph, categoryUrl, docCrumbs, readingMinutes, wordCount } from '../../lib/schema';
import { SITE, abs, repoLinks } from '../../lib/site';
import { CATEGORIES, type Category } from '../../lib/taxonomy';

type Groups = { category: Category; docs: Doc[] }[];

export async function getStaticPaths() {
	const docs = await getDocs();
	const byId = new Map(docs.map((doc) => [doc.id, doc]));
	const groups = byCategory(docs);
	return docs.map((doc) => ({
		params: { slug: doc.id },
		// getDocs() has already checked that every related id is published.
		props: { doc, groups, related: doc.data.related.map((id) => byId.get(id)!) },
	}));
}

const { doc, groups, related } = Astro.props as { doc: Doc; groups: Groups; related: Doc[] };
const { Content, headings } = await render(doc);
const d = doc.data;
const category = CATEGORIES[d.category];
const pageTitle = `${d.title} — SFDX Talk`;
const minutes = readingMinutes(wordCount(doc.body ?? ''));
const human = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const level = d.level[0].toUpperCase() + d.level.slice(1);
const contributors = contributorsFor(doc.id);
const links = repoLinks(doc.id);
const { prev, next } = neighbours(groups.find((g) => g.category === d.category)?.docs ?? [], doc);
---

<BaseLayout
	title={pageTitle}
	description={d.description}
	jsonLd={articleGraph(doc, pageTitle, contributors)}
	article={{ published: d.published, modified: d.lastUpdated, section: category.label, tags: d.tags }}
	markdownPath={docMarkdownUrl(doc)}
	ogImage={{ path: docOgImagePath(doc), alt: docOgImageAlt(doc) }}
>
	<div class="page article-layout">
		<DocsNav groups={groups} current={doc} />

		<article class="article" data-pagefind-body>
			<header class="article-header">
				<div data-pagefind-ignore><Breadcrumbs crumbs={docCrumbs(doc)} /></div>
				<h1>{d.title}</h1>
				<div class="article-meta" data-pagefind-ignore>
					<p class="doc-meta">
						<a class="badge badge-release" href={releaseUrl(d.release)} data-pagefind-filter="release">{d.release}</a>
						<span class="badge">API {d.apiVersion}</span>
						<span class="badge" data-pagefind-filter={`level:${d.level}`}>{level}</span>
						<span>Last updated <time datetime={isoDate(d.lastUpdated)}>{human(d.lastUpdated)}</time></span>
						<span>{minutes} min read</span>
						<span><a href={categoryUrl(d.category)} data-pagefind-filter="category" data-pagefind-meta="category">{category.label}</a></span>
						<span>By {SITE.editorial}</span>
					</p>
					<ul class="doc-tags" aria-label="Tags">
						{
							d.tags.map((tag) => (
								<li>
									<a href={tagUrl(tag)} rel="tag" data-pagefind-filter="tag">{tag}</a>
								</li>
							))
						}
					</ul>
				</div>
				<div class="tldr">
					<p class="tldr-label" data-pagefind-ignore>Quick answer</p>
					<p>{d.tldr}</p>
				</div>
			</header>

			<Toc items={buildToc(headings)} />

			<div class="article-body">
				<div class="prose">
					<Content />
					<h2 id={FAQ_SECTION.id}>{FAQ_SECTION.text}</h2>
					{
						d.faq.map((f) => (
							<>
								<h3>{f.q}</h3>
								<p>{f.a}</p>
							</>
						))
					}
				</div>

				<footer class="article-footer" data-pagefind-ignore>
					{
						related.length > 0 && (
							<section aria-labelledby="related-articles">
								<h2 id="related-articles">Related articles</h2>
								<ul class="related-list">
									{related.map((r) => (
										<li>
											<a href={docUrl(r)}>{r.data.title}</a>
											<p>{r.data.description}</p>
										</li>
									))}
								</ul>
							</section>
						)
					}
					{
						(prev || next) && (
							<nav class="pager" aria-label={`More in ${category.label}`}>
								{prev && (
									<a class="pager-prev" href={docUrl(prev)} rel="prev">
										<span class="pager-label">Previous</span>
										<span class="pager-title">{prev.data.title}</span>
									</a>
								)}
								{next && (
									<a class="pager-next" href={docUrl(next)} rel="next">
										<span class="pager-label">Next</span>
										<span class="pager-title">{next.data.title}</span>
									</a>
								)}
							</nav>
						)
					}
					<div class="community">
						<p class="community-lead">
							SFDX Talk is maintained by the community. Spotted something outdated or wrong?
						</p>
						<p class="community-links">
							<a href={links.edit} rel="noopener">Edit this page on GitHub</a>
							<a href={links.issue(abs(docUrl(doc)), d.title)} rel="noopener">Report a problem</a>
							<a href={links.history} rel="noopener">Page history</a>
						</p>
						{
							contributors.length > 0 && (
								<p class="contributors">
									Contributors:{' '}
									{contributors.map((c, i) => (
										<>
											{i > 0 && ', '}
											{c.url ? <a href={c.url} rel="noopener">{c.name}</a> : c.name}
										</>
									))}
								</p>
							)
						}
						<p class="license">
							Published by {SITE.editorial} under <a href={SITE.contentLicense.url} rel="license noopener">{SITE.contentLicense.name}</a>.
						</p>
					</div>
					<p class="page-actions">
						<a href={docMarkdownUrl(doc)} data-astro-prefetch="false">View as Markdown</a>
						<button class="copy-page" type="button" data-copy-page={docMarkdownUrl(doc)}>Copy page for AI</button>
						<span class="visually-hidden" role="status" data-copy-page-status></span>
					</p>
				</footer>
				<Comments term={doc.id} />
			</div>
		</article>
	</div>
	<script>
		import '../../scripts/article';
	</script>
</BaseLayout>
