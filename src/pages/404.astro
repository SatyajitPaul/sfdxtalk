---
// Served by Cloudflare via `not_found_handling: "404-page"` for any unknown
// URL, so every link here is root-relative.
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDocs } from '../lib/docs';
import { byCategory } from '../lib/export';
import { DOCS_INDEX_URL, RELEASES_INDEX_URL } from '../lib/hubs';
import { categoryUrl } from '../lib/schema';
import { CATEGORIES } from '../lib/taxonomy';

const groups = byCategory(await getDocs());
---

<BaseLayout title="Page not found — SFDX Talk" description="This page does not exist on SFDX Talk." canonicalPath="/404/" noindex>
	<div class="page-narrow">
		<h1>Page not found</h1>
		<p>
			The page you're looking for doesn't exist or has moved. Check the address for typos, or start from one of
			these:
		</p>
		<ul>
			<li><a href="/">SFDX Talk home page</a></li>
			<li><a href={DOCS_INDEX_URL}>All documentation categories</a></li>
			<li><a href={RELEASES_INDEX_URL}>Articles by Salesforce release</a></li>
		</ul>
		<h2>Browse by category</h2>
		<ul>
			{
				groups.map((g) => (
					<li>
						<a href={categoryUrl(g.category)}>{CATEGORIES[g.category].label}</a>
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>
