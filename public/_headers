# Cloudflare Workers static assets: custom response headers.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# Limits: 100 rules, 2,000 chars per line.
# HTML keeps Cloudflare's default (max-age=0, must-revalidate + ETag)
# so content updates are visible immediately after deploy.

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Astro build assets have content hashes in their names: cache for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
