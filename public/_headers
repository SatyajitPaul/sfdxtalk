# Cloudflare Workers static assets: custom response headers.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
# Limits: 100 rules, 2,000 chars per line.
#
# Caching layers (see docs/PLAN.md §9):
#   1. HTML keeps Cloudflare's default (max-age=0, must-revalidate + ETag),
#      so the network copy is always current; the service worker serves
#      visited pages instantly from its cache and refreshes them in the background.
#   2. /_astro/* files have content hashes in their names: cached for a year.
#   3. Icons and the manifest change rarely: cached for a week.

# Security headers on every response
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker script must always be checked for updates
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/icon-*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
